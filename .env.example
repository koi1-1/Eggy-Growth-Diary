# ===== 蛋养学习 · 环境变量模板 =====
# 用法：复制本文件为 .env，填入真实值。
# ⚠️ .env 已在 .gitignore 中忽略，绝不提交、绝不打印到日志或输出。

# ---------- 服务端口 ----------
PORT=3000
NODE_ENV=development

# ---------- 知乎 OAuth（黑客松赛事页面领取 App ID / App Key）----------
# 未填写时，登录自动走 Mock 模式（仅开发可用，线上会拒绝）
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
# 必须与赛事页面登记的回调地址【完全一致】（协议/域名/端口/路径/尾部斜杠）
# 本地开发示例：http://localhost:3000/api/auth/callback
ZHIHU_OAUTH_REDIRECT_URI=

# ---------- 知乎开放平台 Access Secret ----------
# 仅用于服务端读取「授权用户的收藏/创作列表」，Step 3 起需要
ZHIHU_ACCESS_SECRET=

# ---------- LLM（Step 3 聚类、Step 4 课程、Step 5 出题）----------
# 未填写时自动降级为规则聚类（真实算法，不伪造内容）
# 推荐使用 OpenAI 兼容接口；设置 LLM_PROVIDER=openai 后填写以下配置。
LLM_PROVIDER=deepseek
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 开发开关 ----------
# 置为 1 时强制启用 Mock 登录（无需知乎凭证即可联调前端）
MOCK_AUTH=0
